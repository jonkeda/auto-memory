<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\Version.props" />

  <ItemGroup>
    <ProjectReference Include="..\AutoMemory.Core\AutoMemory.Core.csproj" />
    <ProjectReference Include="..\AutoMemory.Cli\AutoMemory.Cli.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>session-recall-mcp</AssemblyName>
    <RootNamespace>AutoMemory.Mcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
